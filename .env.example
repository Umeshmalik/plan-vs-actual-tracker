# Shape only — real values live in Vercel's environment store, never in the repo.
# Copy to .env.local for development: cp .env.example .env.local

# Required. Mongo connection string; the app never creates the DB user.
#
# Local (docker compose up -d mongo). directConnection=true is required FROM THE
# HOST: the replica set advertises itself as "mongo:27017", which only resolves
# inside the compose network. Containers on that network drop the flag.
MONGODB_URI=mongodb://localhost:27017/pva?replicaSet=rs0&directConnection=true
#
# Production (Atlas):
# MONGODB_URI=mongodb+srv://pva-app:<password>@<cluster>/pva

# Required. Signs the Auth.js session cookie. Generate: openssl rand -base64 32
AUTH_SECRET=<openssl rand -base64 32>

# Optional. Stamped into GET /api/health `version` and every log line.
# CI sets it to the commit SHA; defaults to "dev".
# GIT_SHA=

# Optional. pino level: trace|debug|info|warn|error. Defaults to "info".
# LOG_LEVEL=
